{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://donaron.dev/schemas/donaron-plugin.v1.schema.json",
  "title": "DonAron Universal Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "description",
    "compatibility",
    "permissions",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifestVersion": {
      "type": "string",
      "const": "1"
    },
    "id": {
      "$ref": "#/$defs/pluginId"
    },
    "name": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "displayName": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "version": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "description": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "author": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "url": {
              "$ref": "#/$defs/httpsUrl"
            }
          }
        }
      ]
    },
    "license": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "homepage": {
      "$ref": "#/$defs/httpsUrl"
    },
    "repository": {
      "oneOf": [
        {
          "$ref": "#/$defs/httpsUrl"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url"],
          "properties": {
            "type": {
              "type": "string",
              "const": "git"
            },
            "url": {
              "$ref": "#/$defs/httpsUrl"
            }
          }
        }
      ]
    },
    "logo": {
      "allOf": [
        {
          "$ref": "#/$defs/safeRelativePath"
        },
        {
          "type": "string",
          "pattern": "\\.(png|svg|jpg|jpeg|webp)$"
        }
      ]
    },
    "suggestedPrompts": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["donaronPlugin"],
      "properties": {
        "donaronPlugin": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "harnesses": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "additionalProperties": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["fs:read", "fs:write", "cmd:exec", "net:outbound", "env:read"]
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "$ref": "#/$defs/safePathArray"
        },
        "agents": {
          "$ref": "#/$defs/safePathArray"
        },
        "rules": {
          "$ref": "#/$defs/safePathArray"
        },
        "hooks": {
          "$ref": "#/$defs/safePathArray"
        },
        "tools": {
          "$ref": "#/$defs/safePathArray"
        },
        "policies": {
          "$ref": "#/$defs/safePathArray"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "versionRange"],
        "properties": {
          "id": {
            "$ref": "#/$defs/pluginId"
          },
          "versionRange": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    }
  },
  "$defs": {
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s/]+"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?![a-zA-Z]:)(?! +$)(?![\\s\\S]*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\u0000-\\u001f\\u007f:]+$"
    },
    "safePathArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/safeRelativePath"
      }
    }
  }
}
